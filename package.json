{
  "name": "@usagey/sdk",
  "version": "0.2.0",
  "description": "Official Node.js SDK for Usagey usage metering and entitlement checks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "examples/*.ts",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "check:examples": "tsc -p tsconfig.examples.json",
    "test": "jest",
    "lint": "eslint src examples",
    "format": "prettier --write \"{src,examples}/**/*.ts\"",
    "verify": "npm run lint && npm run build && npm run check:examples && npm test -- --runInBand",
    "prepare": "npm run build"
  },
  "keywords": [
    "usagey",
    "usage-based-pricing",
    "metering",
    "billing",
    "api"
  ],
  "author": "Usagey Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "eslint": "^10.11.0",
    "jest": "^29.7.0",
    "nock": "^13.5.1",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/8thWanda-Group/usagey-node-sdk"
  }
}
